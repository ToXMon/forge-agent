{
  "name": "forge",
  "version": "0.1.0",
  "description": "A production-grade full-stack coding agent: durable harness, safe/dangerous tool gates, evals, and deployment adapters for any infrastructure.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "agent": "tsx src/cli.ts",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "lint": "eslint src evals",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.0.4",
    "hono": "^4.6.14",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
