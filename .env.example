# ── LLM provider(s): any OpenAI-compatible API works. ─────────────
# Simplest: single provider (legacy path, still fully supported).
FORGE_BASE_URL=https://api.venice.ai/api/v1
FORGE_API_KEY=
FORGE_MODEL=zai-org/glm-5.2   # ← any model slug your provider hosts
# FORGE_TEMPERATURE=0.2

# Advanced: multiple providers, selectable per session.
#   Format: alias|baseURL|apiKeyEnvVar|model  (comma-separated)
# FORGE_PROVIDERS="venice|https://api.venice.ai/api/v1|VENICE_API_KEY|zai-org/glm-5.2,\
#   surplus|https://api.surplusintelligence.ai/v1|SURPLUS_API_KEY|<model-slug>,\
#   akashml|<AKASH_ML_BASE_URL>|AKASH_ML_API_KEY|<model-slug>,\
#   openrouter|https://openrouter.ai/api/v1|OPENROUTER_API_KEY|deepseek/deepseek-chat-v3-0324"
# FORGE_PROVIDER_DEFAULT=venice

# ── Server ────────────────────────────────────────────────────────
FORGE_PORT=8787

# ── Auth (required in production) ─────────────────────────────────
# Pepper for password hashing — generate once, keep secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_SECRET=
# LLM token credits granted to each new signup (first signup = admin, unlimited).
FORGE_TRIAL_TOKENS=50000

# ── Telegram channel (bot token from @BotFather) — omit to disable ──
# FORGE_TELEGRAM_BOT_TOKEN=
